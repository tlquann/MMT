JWT_SECRET=replace-with-at-least-32-random-characters
AGENT_SHARED_SECRET=replace-with-at-least-16-random-characters
GATEWAY_INTERNAL_KEY=replace-with-at-least-16-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

SERVER_HOST=0.0.0.0
SERVER_PORT=5000

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Sửa thành IP thật của máy bạn (thay 192.168.1.6 bằng IP máy thật của bạn)
GATEWAY_INTERNAL_URL=http://192.168.1.6:8080
GATEWAY_WS_URL=ws://192.168.1.6:8080/ws/agent

REMOTE_ADMIN_CONSENT=false
ALLOW_POWER_ACTIONS=false